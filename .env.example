# ═══════════════════════════════════════════════════════════════════
# .env.example — Modelo de variáveis de ambiente
# ═══════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env real no Git.

# ─── Ambiente ───
NODE_ENV=development
PORT=3000

# ─── Banco de Dados ───
DATABASE_URL="postgresql://usuario:senha@localhost:5432/gestao_aeroporto?schema=public"

# ─── Autenticação ───
JWT_SECRET="troque-por-uma-chave-com-no-minimo-16-caracteres"
JWT_EXPIRES_IN=8h

# ─── Segurança extra ───
X_API_KEY="troque-por-uma-api-key-com-no-minimo-16-caracteres"

# ─── Upload ───
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=application/pdf,image/jpeg,image/png

# ─── API Externa (Clima) ───
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1/search"
WEATHER_TIMEOUT_MS=5000